    "pirates": "^4.0.7",
    "pkg-types": "^1.3.1",
    "pluralize": "^8.0.0",
    "postcss": "^8.5.31",
    "postcss-load-config": "^6.0.1",
    "readdirp": "^4.1.2",
    "require-from-string": "^2.0.2",
    "resolve-from": "^5.0.0",
    "rollup": "^4.65.0",
    "siginfo": "^2.0.0",
    "source-map": "^0.7.6",
    "source-map-js": "^1.2.2",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "sucrase": "^3.35.1",
    "supports-color": "^10.2.2",
    "thenify": "^3.3.1",
