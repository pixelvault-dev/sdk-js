{
  "name": "@pixelvault-dev/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for PixelVault — agent-first image hosting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript spec/openapi.json -o src/generated/schema.ts",
    "sync-spec": "node scripts/sync-spec.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["pixelvault", "image-hosting", "sdk", "upload", "agent"],
  "repository": { "type": "git", "url": "git+https://github.com/pixelvault-dev/sdk-js.git" },
  "homepage": "https://pixelvault.dev/docs",
  "author": "PixelVault",
  "license": "MIT",
  "engines": { "node": ">=18.0.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
