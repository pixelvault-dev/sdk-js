    "tree-kill": "^1.2.2",
    "ts-interface-checker": "^0.1.13",
    "type-fest": "^4.41.0",
    "ufo": "^1.6.4",
    "undici-types": "^6.21.0",
    "uri-js-replace": "^1.0.2",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0",
    "yaml-ast-parser": "^0.0.43",
    "yargs-parser": "^21.1.1"
  },
  "bugs": {
    "url": "https://github.com/pixelvault-dev/sdk-js/issues"
  }
}
