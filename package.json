{
  "name": "@pixelvault-dev/sdk",
  "version": "0.5.0",
  "description": "Official JavaScript/TypeScript SDK for PixelVault — agent-first media hosting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript spec/openapi.json -o src/generated/schema.ts",
    "sync-spec": "node scripts/sync-spec.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "pixelvault",
    "media-hosting",
    "image-hosting",
    "video-hosting",
    "sdk",
    "upload",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelvault-dev/sdk-js.git"
  },
  "homepage": "https://pixelvault.dev/docs",
  "author": "PixelVault",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "agent-base": "^7.1.4",
    "ansi-colors": "^4.1.3",
    "any-promise": "^1.3.0",
    "argparse": "^2.0.1",
    "assertion-error": "^2.0.1",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^2.1.7",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "change-case": "^5.4.4",
    "check-error": "^2.1.3",
    "chokidar": "^4.0.3",
    "colorette": "^1.4.0",
    "commander": "^4.1.1",
    "confbox": "^0.1.8",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.27.7",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fast-deep-equal": "^3.1.3",
    "fdir": "^6.5.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "fsevents": "^2.3.3",
    "https-proxy-agent": "^7.0.6",
    "index-to-position": "^1.2.0",
    "joycon": "^3.1.1",
    "js-levenshtein": "^1.1.6",
    "js-tokens": "^4.0.0",
    "js-yaml": "^4.3.2",
    "json-schema-traverse": "^1.0.0",
    "lilconfig": "^3.1.4",
    "lines-and-columns": "^1.2.4",
    "load-tsconfig": "^0.2.5",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "minimatch": "^5.1.9",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "nanoid": "^3.3.20",
    "object-assign": "^4.1.1",
    "parse-json": "^8.3.0",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
